@page "/statistics"
@page "/statistics/{vanity}"
@using System.Diagnostics
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ILogger<Statistics> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Tiny Blazor Admin - Statistics</PageTitle>
<h1>@SubTitle</h1>
<MudButton Href="/urlmanager" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-4">Back</MudButton>

@if (isLoading)
{
    <div class="loading-state" role="status"><MudProgressCircular Indeterminate="true" />Counting all those clicks...</div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    <MudButton OnClick="LoadStatistics">Retry</MudButton>
}
else
{
    <MudDateRangePicker Label="Date range (local dates)" DateRange="dateRange" DateRangeChanged="ChangeDateRange"
                        Clearable="true" DateFormat="MM/dd/yyyy" Class="mb-4" />
    @if (filteredClicks.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No Click Data</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <MudText Typo="Typo.h6">Click Stats</MudText>
            <MudTimeSeriesChart ChartSeries="dailySeries" TimeLabelFormat="MM/dd/yyyy"
                                TimeLabelSpacing="@TimeSpan.FromDays(1)" DataMarkerTooltipTimeLabelFormat="MM/dd/yyyy"
                                Width="100%" Height="350px" ChartOptions="chartOptions" />
            <MudSimpleTable Dense="true" Class="mt-2" aria-label="Clicks by day">
                <thead><tr><th>Date</th><th>Click(s) by Day</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < dailyLabels.Length; i++)
                    {
                        <tr><td>@dailyLabels[i]</td><td>@dailySeries[0].Data[i].Value</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
        <MudGrid>
            <MudItem xs="12" sm="6" lg="3"><StatisticsPie Title="ShortUrl Statistics" Clicks="filteredClicks" Category="@(x => x.ShortUrl)" /></MudItem>
            <MudItem xs="12" sm="6" lg="3"><StatisticsPie Title="Platform Statistics" Clicks="filteredClicks" Category="@(x => x.Platform)" /></MudItem>
            <MudItem xs="12" sm="6" lg="3"><StatisticsPie Title="Mobile Browser Statistics" Clicks="filteredClicks" Category="@(x => x.Browser)" /></MudItem>
            <MudItem xs="12" sm="6" lg="3"><StatisticsPie Title="Device Type Statistics" Clicks="filteredClicks" Category="@(x => x.IsDesktop ? "Desktop" : "Mobile")" /></MudItem>
        </MudGrid>
        <MudExpansionPanels Class="mt-4">
            <MudExpansionPanel Text="Click Data">
                <MudDataGrid T="ClickStatsEntity" Items="filteredClicks" RowsPerPage="50" SortMode="SortMode.Multiple" Dense="true" Hover="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Date" Title="Timestamp" Format="MM/dd/yyyy hh:mm:ss tt" />
                        <PropertyColumn Property="x => x.Page" Title="Page" />
                        <PropertyColumn Property="x => x.ShortUrl" Title="ShortUrl" />
                        <PropertyColumn Property="x => x.BrowserWithVersion" Title="Browser" />
                        <PropertyColumn Property="x => x.PlatformWithVersion" Title="Platform" />
                        <PropertyColumn Property="x => x.ReferrerUrl" Title="ReferrerUrl" />
                    </Columns>
                    <PagerContent><MudDataGridPager T="ClickStatsEntity" PageSizeOptions="@(new[] { 50, 100 })" /></PagerContent>
                </MudDataGrid>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
}

@code {
    [Parameter] public string vanity { get; set; }

    private string SubTitle => string.IsNullOrEmpty(vanity) ? "All Click Stats" : $"Click Stats for: {vanity}";
    private bool isLoading = true;
    private string errorMessage;
    private List<ClickStatsEntity> clicks = new();
    private List<ClickStatsEntity> filteredClicks = new();
    private DateRange dateRange;
    private List<TimeSeriesChartSeries> dailySeries = new();
    private string[] dailyLabels = Array.Empty<string>();
    private readonly ChartOptions chartOptions = new() { YAxisTicks = 1, LineStrokeWidth = 2 };

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.IsInRole("admin") || Debugger.IsAttached)
        {
            dateRange = null;
            await LoadStatistics();
        }
        else
            NavigationManager.NavigateTo("/unauthorized");
    }

    private async Task LoadStatistics()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            using var response = await Http.PostAsJsonAsync("/api/UrlStats", new UrlClickStatsRequest(vanity));
            if (response.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
                NavigationManager.NavigateTo("/unauthorized");
            response.EnsureSuccessStatusCode();
            var result = await response.Content.ReadFromJsonAsync<ClickStatsEntityList>();
            clicks = result?.ClickStatsList ?? throw new JsonException("The click statistics response was empty.");
            ApplyDateRange();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or FormatException or TaskCanceledException)
        {
            Logger.LogError(ex, "Unable to load click statistics");
            errorMessage = "Unable to load click statistics. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ChangeDateRange(DateRange range)
    {
        dateRange = range;
        ApplyDateRange();
    }

    private void ApplyDateRange()
    {
        var start = dateRange?.Start?.Date;
        var end = dateRange?.End?.Date;
        filteredClicks = clicks.Where(x =>
            (!start.HasValue || x.Date.Date >= start.Value) &&
            (!end.HasValue || x.Date.Date <= end.Value))
            .ToList();
        var daily = filteredClicks.GroupBy(x => x.Date.Date).OrderBy(x => x.Key).ToList();
        dailyLabels = daily.Select(x => x.Key.ToString("MM/dd/yyyy")).ToArray();
        dailySeries = new()
        {
            new TimeSeriesChartSeries
            {
                Name = "Click(s) by Day",
                ShowDataMarkers = true,
                Data = daily.Select(x => new TimeSeriesChartSeries.TimeValue(x.Key, x.Count())).ToList()
            }
        };
    }
}
