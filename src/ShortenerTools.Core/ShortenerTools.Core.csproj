<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<CarpaNet_JsonContextName>ATProtoJsonContext</CarpaNet_JsonContextName>
		<CarpaNet_LexiconAutoResolve>true</CarpaNet_LexiconAutoResolve>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Azure.Communication.Email" />
		<PackageReference Include="cronos" />
		<PackageReference Include="Azure.Data.Tables" />
		<PackageReference Include="Azure.Identity" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="System.Text.Json" />
		<PackageReference Include="UAParser" />

		<PackageReference Include="CarpaNet" />
		<PackageReference Include="CarpaNet.SourceGen">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<LexiconResolve Include="app.bsky.feed.post" />
		<LexiconResolve Include="app.bsky.embed.images" />
		<LexiconResolve Include="app.bsky.embed.external" />
		<LexiconResolve Include="app.bsky.richtext.facet" />
		<LexiconResolve Include="com.atproto.repo.createRecord" />
		<LexiconResolve Include="com.atproto.repo.uploadBlob" />
		<LexiconResolve Include="com.atproto.identity.resolveHandle" />
	</ItemGroup>
</Project>